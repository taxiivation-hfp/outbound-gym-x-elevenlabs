# --- ElevenLabs -------------------------------------------------------------
ELEVENLABS_API_KEY=
# Twilio number registered in ElevenLabs, used for every outbound call.
ELEVENLABS_PHONE_NUMBER_ID=
# One agent per call type. Created and kept in sync by:
#   node scripts/sync-agents.mjs
ELEVENLABS_AGENT_ID_RENEWAL=
ELEVENLABS_AGENT_ID_REENGAGEMENT=
ELEVENLABS_AGENT_ID_WINBACK=
# Shared secret for the post-call webhook signature, from the ElevenLabs
# dashboard (Settings -> Webhooks).
ELEVENLABS_WEBHOOK_SECRET=
# Id of that webhook, so sync-agents.mjs can attach it to all three agents.
ELEVENLABS_POST_CALL_WEBHOOK_ID=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (SMS) -----------------------------------------------------------
# Voice goes through ElevenLabs' Twilio integration; the text messages Charlie
# sends go direct, so /api/send-text needs its own credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# --- Deployment -------------------------------------------------------------
# Public origin of the deployed app: the send_text tool's endpoint and the
# links it texts are built from this.
PUBLIC_BASE_URL=

# --- Demo safety ------------------------------------------------------------
# Route every outbound call and text to one verified number instead of the
# member's own. The synthetic dataset's 500 phone numbers are Faker output and
# belong to nobody; leave this set for any demo.
CALL_OVERRIDE_NUMBER=
# Set to "live" to measure time from the wall clock instead of the dataset's
# frozen reference date. Only correct against a real gym feed.
DATASET_CLOCK=
