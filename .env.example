# --- ElevenLabs -------------------------------------------------------------
ELEVENLABS_API_KEY=
# Twilio number registered in ElevenLabs, used for every outbound call.
ELEVENLABS_PHONE_NUMBER_ID=
# One agent per call type. Created and kept in sync by:
#   node scripts/sync-agents.mjs
ELEVENLABS_AGENT_ID_RENEWAL=
ELEVENLABS_AGENT_ID_REENGAGEMENT=
ELEVENLABS_AGENT_ID_WINBACK=
# The fourth agent: the one call a member who has asked to cancel gets.
ELEVENLABS_AGENT_ID_CANCELLATION=
# Shared secret for the post-call webhook signature, from the ElevenLabs
# dashboard (Settings -> Webhooks).
ELEVENLABS_WEBHOOK_SECRET=
# Id of that webhook, so sync-agents.mjs can attach it to all three agents.
ELEVENLABS_POST_CALL_WEBHOOK_ID=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (SMS) -----------------------------------------------------------
# Voice goes through ElevenLabs' Twilio integration; the text messages Charlie
# sends go direct, so /api/send-text needs its own credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# --- Deployment -------------------------------------------------------------
# Public origin of the deployed app: the send_text tool's endpoint and the
# links it texts are built from this.
PUBLIC_BASE_URL=

# --- Demo safety ------------------------------------------------------------
# Route every outbound call and text to one verified number instead of the
# member's own. The synthetic dataset's 500 phone numbers are Faker output —
# well-formed Australian numbers belonging to strangers — so while
# data/dataset_meta.json says the dataset is synthetic, /api/call REFUSES to
# dial unless this is set. That refusal is the point: a deployment with the
# agent ids filled in and this left blank would ring 173 real people and look
# exactly like a working demo while it did.
CALL_OVERRIDE_NUMBER=
# The deliberate opt-in to dial a gym's uploaded members (MEMBER_SOURCE=supabase)
# with their consent. It never dials the synthetic dataset's numbers: those
# always need CALL_OVERRIDE_NUMBER.
ALLOW_UNVERIFIED_NUMBERS=
# Set to "live" to measure time from the wall clock instead of the dataset's
# frozen reference date. The date is frozen only because the dataset is
# synthetic; set this for a gym's real, uploaded member data.
DATASET_CLOCK=

# --- Onboarding -------------------------------------------------------------
# Reads an uploaded price list or membership agreement into typed fields for a
# person to review (/onboarding). Extraction only fills fields; the compiler
# writes every sentence the agent hears. Unset: the document path says it is
# switched off and the form still works by hand.
ANTHROPIC_API_KEY=
# Where the queue, /api/call and send_text read members from. Unset or
# "dataset": the synthetic dataset. "supabase": one gym's uploaded members
# (contracts, check-ins) — MEMBER_SOURCE_GYM_ID says which gym, and every
# reader refuses unless DATASET_CLOCK is "live".
MEMBER_SOURCE=
MEMBER_SOURCE_GYM_ID=
# Saving a gym at /onboarding and importing member data both write the facts
# calls are decided on, and neither route has a login. Off unless set to
# "enabled" — set it only once access protection is in front of the deployment.
ONBOARDING_WRITES=
# Vercel Cron sends this as a bearer token to /api/cron/recompute (vercel.json).
# Unset: the nightly recompute refuses to run rather than running for anyone.
CRON_SECRET=
